flowchart TD
    subgraph Input
        A["data/songs.csv"]
        B["Free-text request<br/>e.g. 'I want calm music<br/>for studying'"]
        B2["Structured Q&A<br/>(genre/mood/energy/acoustic)<br/>if no free text given"]
    end

    subgraph DataLayer["Data Layer"]
        C["load_songs()"]
        A --> C
    end

    subgraph Parser["NL Parser (RAG)"]
        P["parse_user_request()<br/>Gemini, grounded ONLY in the<br/>catalog's real genre/mood vocabulary"]
        PG{"Guardrail<br/>API key present?<br/>call succeeded?<br/>valid JSON?"}
        B --> P --> PG
        PG -- "no / fails" --> PF["Keyword + synonym<br/>fallback parser"]
        PG -- "yes" --> PS["Structured prefs<br/>(genre, mood, energy, likes_acoustic)"]
        PF --> PS
        B2 --> PS
    end

    subgraph Engine["Scoring Engine"]
        D["score_song()<br/>scores each song vs. prefs,<br/>returns score + matched reasons"]
        E["Retriever<br/>retrieve_similar_songs()<br/>finds nearest catalog neighbors<br/>by audio attributes"]
        C --> D
        PS --> D
        D --> E
    end

    subgraph Agent["Generation Agent (RAG)"]
        F["generate_explanation()<br/>Gemini, grounded ONLY in<br/>retrieved reasons + neighbors"]
        G{"Guardrail / Evaluator<br/>API key present?<br/>call succeeded?<br/>response non-empty?"}
        E --> F --> G
        G -- "no / fails" --> H["Fallback template<br/>(deterministic, same facts)"]
        G -- "yes" --> I["Grounded explanation"]
    end

    subgraph Output
        J["Ranked Top-k Recommendations<br/>(song, score, explanation)"]
        H --> J
        I --> J
    end

    subgraph HumanCheck["Human & Automated Testing"]
        K["pytest suite<br/>tests/test_recommender.py<br/>checks scoring, parsing + explanation validity"]
        L["Developer review<br/>runs CLI, reads logs/app.log,<br/>judges output quality"]
    end

    K -. validates .-> Parser
    K -. validates .-> D
    K -. validates .-> Agent
    J --> L
    L -. flags issues back to .-> D

    M["src/main.py<br/>CLI entry point"] --> C
    M --> Parser
    J --> M
